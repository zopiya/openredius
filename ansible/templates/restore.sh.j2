#!/bin/bash
# OpenRedius 恢复(Ansible 渲染的薄封装)。
# 不维护第二份恢复逻辑:统一调用 deploy/scripts/restore.sh 正典(见 ansible/DESIGN.md)。
# 用法:restore.sh <dump.gz>  [FORCE=1 跳过交互确认]
set -euo pipefail

DUMP="${1:?Usage: restore.sh <dump-file.gz>}"

FORCE="${FORCE:-0}" RESTORE_METHOD=compose \
COMPOSE_FILE="{{ openredius_deploy_root }}/docker-compose.yml" \
  bash "{{ openredius_deploy_root }}/deploy/scripts/restore.sh" "$DUMP"
