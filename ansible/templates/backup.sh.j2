#!/bin/bash
# OpenRedius 备份(Ansible 渲染的薄封装)。
# 不维护第二份备份逻辑:统一调用 deploy/scripts/backup.sh 正典(见 ansible/DESIGN.md)。
set -euo pipefail

BACKUP_DIR="{{ openredius_deploy_root }}/backups" \
RETENTION="{{ openredius_backup_retention }}" \
BACKUP_METHOD=compose \
COMPOSE_FILE="{{ openredius_deploy_root }}/docker-compose.yml" \
  bash "{{ openredius_deploy_root }}/deploy/scripts/backup.sh"
