# OpenRedius 运行时密钥 — 由 Ansible 渲染(勿手改,源: vault.yml)
# 权限 600;compose 经 ${VAR:?} 引用本文件。

POSTGRES_PASSWORD={{ vault_postgres_password }}
OPENRADIUS_DB_PASSWORD={{ vault_openredius_db_password }}
RADIUS_SQL_PASSWORD={{ vault_radius_sql_password }}
OPENRADIUS_JWT_SECRET={{ vault_jwt_secret }}
OPENRADIUS_BOOTSTRAP_ADMIN_USER={{ vault_bootstrap_admin_user | default('admin') }}
OPENRADIUS_BOOTSTRAP_ADMIN_PASSWORD={{ vault_bootstrap_admin_password | default('') }}
OPENRADIUS_RADIUS_COA_SECRET={{ vault_radius_coa_secret | default('') }}
OPENRADIUS_ENV={{ openredius_env }}
OPENRADIUS_JWT_ACCESS_TTL=15m
OPENRADIUS_JWT_REFRESH_TTL=7d
OPENRADIUS_RADIUS_COA_PORT=3799
NAS_UDP_EXPOSE={{ openredius_nas_udp_expose }}
FRONTEND_HTTP_PORT={{ openredius_frontend_http_port }}
FRONTEND_HTTPS_PORT={{ openredius_frontend_https_port }}
{% if vault_ad_url | default('') | length > 0 %}
OPENRADIUS_AD_URL={{ vault_ad_url }}
OPENRADIUS_AD_BIND_DN={{ vault_ad_bind_dn }}
OPENRADIUS_AD_BIND_PW={{ vault_ad_bind_pw }}
OPENRADIUS_AD_BASE_DN={{ vault_ad_base_dn }}
{% endif %}
