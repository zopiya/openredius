{
  "name": "openredius-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "准入认证控制台 — RADIUS 802.1X 企业内网准入管理(React + TypeScript + bun)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "tsc -b && bun scripts/smoke.tsx && bun test && VITE_API_MODE=http bun test tests/http.test.ts && bun scripts/fidelity.tsx",
    "e2e": "bun scripts/e2e.mjs",
    "e2e:http": "bun scripts/e2e-http.mjs",
    "api:gen": "bunx openapi-typescript@6 http://localhost:8000/api/openapi.json -o src/api/schema.d.ts --enum"
  },
  "dependencies": {
    "@ant-design/charts": "2",
    "@ant-design/icons": "6",
    "antd": "6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "~7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
