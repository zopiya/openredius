# OpenRedius 生产部署环境变量模板(deploy/.env)
# 用法:cp deploy/.env.example deploy/.env && $EDITOR deploy/.env
# .env 永不入库。
# 详细说明:docs/07-deployment.md · deploy/README.md

# ========== 必须修改(prod) ==========

# PostgreSQL 超级角色口令
POSTGRES_PASSWORD=change-me-postgres

# 应用库角色(openredius)口令
OPENRADIUS_DB_PASSWORD=change-me-openredius

# FreeRADIUS SQL 角色(radius)口令
RADIUS_SQL_PASSWORD=change-me-radius

# JWT 签名密钥(长度 ≥32)
OPENRADIUS_JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# 首次启动自动创建的管理员
OPENRADIUS_BOOTSTRAP_ADMIN_USER=admin
OPENRADIUS_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-first-login

# ========== 可选调整 ==========

# 运行模式(默认 prod)
OPENRADIUS_ENV=prod

# JWT 过期时间
OPENRADIUS_JWT_ACCESS_TTL=15m
OPENRADIUS_JWT_REFRESH_TTL=7d

# RADIUS CoA(强制下线)端口(NAS 端监听;共享密钥按 NAS 在设备管理页配置)
OPENRADIUS_RADIUS_COA_PORT=3799

# RADIUS 重载哨兵目录(docs/16):backend 写入 reload-requested,freeradius
# 容器内 watcher 重启 radiusd 后写 reload-applied。compose 默认值
# /var/run/openredius 与卷挂载一致,留空 = 手动模式(需手工 restart 容器)。
OPENRADIUS_RADIUS_RELOAD_DIR=/var/run/openredius

# AD/LDAP 同步(全部留空 = 禁用)
OPENRADIUS_AD_URL=
OPENRADIUS_AD_BIND_DN=
OPENRADIUS_AD_BIND_PW=
OPENRADIUS_AD_BASE_DN=

# AD 增量同步 cron
OPENRADIUS_AD_SYNC_CRON=*/15 * * * *

# 账号锁定策略
OPENRADIUS_LOCKOUT_MAX_FAILS=5
OPENRADIUS_LOCKOUT_WINDOW=600
OPENRADIUS_LOCKOUT_DURATION=1800

# 后台任务开关(默认启用)
OPENRADIUS_JOBS_ENABLED=true

# ========== 部署参数 ==========

# NAS 网段 UDP 端口映射(compose)
NAS_UDP_EXPOSE=1812-1813

# 前端 HTTP/HTTPS 端口映射(compose)
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# 镜像标签(默认 latest;建议生产指定版本)
TAG=latest

# ========== AD 直通认证(docs/15 方案 A)==========
# 全部留空 = 特性完全跳过(freeradius 不 join 域、不启 winbind)。
# 生产启用:填 REALM/JOIN_USER/JOIN_PASSWORD 三项,AD 管理员单独开的
# 委派 join 账号,不复用现有 radius 只读账号。凭据只经 compose env 注入
# 容器,join 状态(secrets.tdb/keytab)存于 samba-state 卷,不入镜像/仓库。
# Kerberos realm,大写 DNS 域名,如 CONTOSO.COM
RADIUS_AD_REALM=
# NetBIOS 工作组/短域名,如 CONTOSO;留空取 REALM 首段
RADIUS_AD_WORKGROUP=
# 域控地址,如 10.36.5.245;留空走 DNS SRV 自动发现
RADIUS_AD_KDC=
# 域 join 委派账号(UPN 或 NETBIOS\user)
RADIUS_AD_JOIN_USER=
RADIUS_AD_JOIN_PASSWORD=
# freeradius 容器 DNS;留空用 Docker 内嵌 DNS(继承宿主机解析),
# 宿主不能解析 AD 域名时指向域控/企业 DNS
RADIUS_AD_DNS_SERVER=
