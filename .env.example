# OpenRedius 环境变量模板(dev 默认值)
# 用法:cp .env.example .env 后按需修改;.env 永不入库。
# 键来源:docs/04-backend-design.md「配置」表 + docs/07-deployment.md「环境变量」表。

# ---------- 后端应用配置(前缀 OPENRADIUS_,见 docs/04) ----------

# 运行模式:dev/prod;prod 下强制校验密钥类配置(JWT_SECRET 长度 ≥32 等)
OPENRADIUS_ENV=dev

# 应用数据库连接;本地 dev 用 SQLite,集成/prod 换 postgresql+asyncpg://…(见 docs/07)
OPENRADIUS_DATABASE_URL=sqlite+aiosqlite:///./openredius-dev.db

# JWT 签名密钥;dev 默认值,prod 必须替换为随机值(长度 ≥32)
OPENRADIUS_JWT_SECRET=dev-only-jwt-secret-change-me

# 访问令牌有效期
OPENRADIUS_JWT_ACCESS_TTL=15m

# 刷新令牌有效期
OPENRADIUS_JWT_REFRESH_TTL=7d

# NAS 侧 CoA(强制下线)端口
OPENRADIUS_RADIUS_COA_PORT=3799

# CoA 请求超时(秒)
OPENRADIUS_RADIUS_COA_TIMEOUT=3.0

# NAS 在线判定窗口(秒);超过该窗口无 Accounting 报文视为离线
OPENRADIUS_NAS_ONLINE_WINDOW=300

# AD/LDAP 同步(全部留空 = 禁用 AD 同步)
OPENRADIUS_AD_URL=
OPENRADIUS_AD_BIND_DN=
OPENRADIUS_AD_BIND_PW=
OPENRADIUS_AD_BASE_DN=
OPENRADIUS_AD_FILTER=

# AD 增量同步 cron 表达式
OPENRADIUS_AD_SYNC_CRON=*/15 * * * *

# 账号锁定策略(与原型文案一致):窗口内失败次数上限 / 统计窗口(秒)/ 锁定时长(秒)
OPENRADIUS_LOCKOUT_MAX_FAILS=5
OPENRADIUS_LOCKOUT_WINDOW=600
OPENRADIUS_LOCKOUT_DURATION=1800

# 终端证书到期预警天数
OPENRADIUS_CERT_EXPIRE_WARN_DAYS=14

# ---------- 部署/栈集成变量(见 docs/07,compose 场景使用) ----------

# PostgreSQL 超级角色口令(dev 默认;prod 必须替换)
POSTGRES_PASSWORD=dev-only-postgres-password

# 应用库角色(openredius)口令
OPENRADIUS_DB_PASSWORD=dev-only-openredius-password

# FreeRADIUS SQL 读取角色(radius_sql)口令
RADIUS_SQL_PASSWORD=dev-only-radius-sql-password

# 首次启动自动创建的初始管理员账号
OPENRADIUS_BOOTSTRAP_ADMIN_USER=admin

# 初始管理员口令(prod 首次启动后立即修改)
OPENRADIUS_BOOTSTRAP_ADMIN_PASSWORD=dev-only-admin-password

# compose 中 RADIUS 认证/计费 UDP 端口映射
NAS_UDP_EXPOSE=1812-1813
